# Visual Studio 관련 파일들
.vs/
*.vsidx
*.suo
*.user
*.userosscache
*.sln.docstates

# 빌드 결과물 디렉토리 (예: Debug, Release 폴더)
[Dd]ebug/
[Rr]elease/
x64/
build/

# 컴파일 산출물
*.obj
*.exe.recipe
*.tlog/

# IntelliSense 및 관련 임시 파일
.ipch/

# 데이터베이스 파일 (자동 생성되거나 환경에 따라 달라질 수 있음)
*.db

# 환경 설정 파일 (필요한 경우 제외, 일반적으로 로컬 설정 파일이라면 무시)
config.json
*.config.local.json

# 로그 파일들
*.log

# 기타 임시 파일
*.tmp
